---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/PageHero.astro'; import { ArrowUpRight, Building2, Mail, MapPin } from 'lucide-astro'; import { site } from '../data/site';
const profiles = [['Google Scholar',site.profiles.scholar],['ORCID',site.profiles.orcid],['GitHub',site.profiles.github],['LinkedIn',site.profiles.linkedin]];
---
<BaseLayout title="Contact & Collaboration" description="Contact Erick Rodríguez-Esparza about AI, optimization, mobility, and collaborative R&D.">
  <PageHero eyebrow="Contact" number="06" title="Let’s discuss your research or project." intro="I am open to research collaborations, European R&D consortia, and applied work in AI, optimization, mobility, and logistics." />
  <section class="bg-white py-20 lg:py-28"><div class="container grid gap-14 lg:grid-cols-[1fr_.62fr]">
    <div><p class="eyebrow mb-7">Start a conversation</p><h2 class="section-title max-w-3xl">Tell me what you are working on.</h2><p class="mt-6 max-w-2xl text-lg leading-9 text-slate">You can contact me about a research proposal, an R&D consortium, or an applied optimization problem. I am particularly interested in mobility, logistics, transport planning, industrial AI, and decision-support systems.</p><a href={`mailto:${site.email}`} class="mt-8 inline-flex items-center gap-3 rounded-full bg-ink px-6 py-3 text-xs font-extrabold uppercase tracking-[.08em] text-white no-underline hover:bg-teal"><Mail size={15}/> {site.email}</a><div class="mt-10 flex flex-wrap gap-x-6 gap-y-3">{profiles.map(([label,url])=><a href={url} target="_blank" rel="noreferrer" class="link-arrow text-teal">{label} <ArrowUpRight size={14}/></a>)}</div></div>
    <div class="border border-line bg-paper p-8"><p class="text-[.68rem] font-extrabold uppercase tracking-[.14em] text-teal">Institutional affiliation</p><div class="mt-8 flex gap-4"><Building2 class="mt-1 shrink-0 text-teal" size={20}/><div><p class="font-bold">DeustoTech</p><p class="mt-1 text-sm leading-6 text-slate">Faculty of Engineering<br/>University of Deusto</p></div></div><div class="mt-7 flex gap-4"><MapPin class="mt-1 shrink-0 text-teal" size={20}/><p class="text-sm text-slate">Bilbao, Spain</p></div><div class="mt-9 border-t border-line pt-6"><p class="text-xs leading-6 text-slate">Research collaboration · European projects · AI and optimization · Intelligent mobility · Technical R&D</p></div></div>
  </div></section>
</BaseLayout>
