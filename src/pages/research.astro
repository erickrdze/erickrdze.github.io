---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionIntro from '../components/SectionIntro.astro';
import { capabilities, researchAreas } from '../data/site';
---
<BaseLayout title="Research & Expertise" description="Research in evolutionary computation, AI, optimization, intelligent mobility, image processing, and scientific software.">
  <PageHero eyebrow="Research & expertise" number="02" title="Methods chosen for the problem at hand." intro="I combine scientific research with software development to study complex systems and support decisions that need to work beyond the lab." />

  <section class="bg-white py-20 lg:py-28"><div class="container">
    <SectionIntro eyebrow="Scientific research" title="Research directions and methodological contributions." description="The common thread is intelligent optimization: choosing, designing, and evaluating methods that fit the problem rather than applying a fixed recipe." />
    <div class="mt-12 grid sm:grid-cols-2">{researchAreas.map(area=><article id={area.slug} class="min-h-[360px] border border-line p-8 scroll-mt-24"><span class="font-mono text-xs text-teal">{area.number}</span><h2 class="mt-14 max-w-md font-display text-3xl leading-[1.08] tracking-[-.035em]">{area.title}</h2><p class="mt-5 text-sm font-semibold leading-7 text-ink">{area.short}</p><p class="mt-4 text-sm leading-7 text-slate">{area.body}</p></article>)}</div>
  </div></section>

  <section id="software" class="bg-ink py-20 text-white scroll-mt-24 lg:py-28"><div class="container">
    <SectionIntro eyebrow="Methods, software & technical capabilities" title="From computational methods to usable research tools." description="I use research software to test assumptions, compare alternatives, and communicate evidence with collaborators and domain specialists." light />
    <div class="mt-12 grid border-t border-white/15 lg:grid-cols-3">{capabilities.map((group,index)=><article class="border-b border-white/15 py-8 lg:border-b-0 lg:border-r lg:px-8 lg:first:pl-0"><span class="font-mono text-xs text-teal-light">0{index + 1}</span><h3 class="mt-8 font-display text-3xl tracking-[-.03em]">{group.title}</h3><ul class="mt-6 grid list-disc gap-2 pl-4 text-sm leading-7 text-white/65 marker:text-teal-light">{group.items.map(item=><li>{item}</li>)}</ul></article>)}</div>
    <div class="mt-12 grid gap-7 border-t border-white/15 pt-8 md:grid-cols-2"><p class="text-sm leading-7 text-white/65">My work typically combines algorithmic modelling, experiment design, data preparation, and implementation. The technical stack follows the research question and the constraints of the application.</p><p class="text-sm leading-7 text-white/65">I prioritise transparent assumptions, reproducible workflows, and outputs that can be discussed by both technical and domain experts.</p></div>
  </div></section>
</BaseLayout>
