---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/PageHero.astro'; import SectionIntro from '../components/SectionIntro.astro'; import { capabilities, researchAreas } from '../data/site';
---
<BaseLayout title="Research & Expertise" description="Research in evolutionary computation, AI, optimization, intelligent mobility, image processing, and scientific software.">
  <PageHero eyebrow="Research & expertise" number="02" title="Methods chosen for the problem at hand." intro="My work combines optimization, prediction, routing, simulation, and image analysis according to the needs of each application." />
  <section class="bg-white py-20 lg:py-28"><div class="container"><SectionIntro eyebrow="Research areas" title="Four areas that support my research." description="The common thread is optimization, supported by machine learning, domain models, and careful experimental evaluation."/><div class="mt-12 grid sm:grid-cols-2">{researchAreas.map(area=><article id={area.slug} class="min-h-[360px] border border-line p-8 scroll-mt-24"><span class="font-mono text-xs text-teal">{area.number}</span><h2 class="mt-14 max-w-md font-display text-3xl leading-[1.08] tracking-[-.035em]">{area.title}</h2><p class="mt-5 text-sm font-semibold leading-7 text-ink">{area.short}</p><p class="mt-4 text-sm leading-7 text-slate">{area.body}</p></article>)}</div></div></section>
  <section id="software" class="bg-ink py-20 text-white scroll-mt-24 lg:py-28"><div class="container"><SectionIntro eyebrow="Technical practice" title="The tools behind the research." description="Research software allows me to test ideas, compare alternatives, and share results with the wider project team." light/><div class="mt-12 grid border-t border-white/15 lg:grid-cols-3">{capabilities.map((group,index)=><article class="border-b border-white/15 py-8 lg:border-b-0 lg:border-r lg:px-8 lg:first:pl-0"><span class="font-mono text-xs text-teal-light">0{index+1}</span><h3 class="mt-8 font-display text-3xl tracking-[-.03em]">{group.title}</h3><ul class="mt-6 grid list-disc gap-2 pl-4 text-sm leading-7 text-white/65 marker:text-teal-light">{group.items.map(item=><li>{item}</li>)}</ul></article>)}</div><p class="mt-10 max-w-3xl text-sm leading-7 text-white/55">The exact stack depends on the project. I prioritise clear assumptions, reproducible experiments, and results that both technical and domain experts can examine.</p></div></section>
</BaseLayout>
