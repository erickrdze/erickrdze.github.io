---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/PageHero.astro'; import SectionIntro from '../components/SectionIntro.astro'; import { capabilities, researchAreas } from '../data/site';
---
<BaseLayout title="Research & Expertise" description="Research in evolutionary computation, AI, optimization, intelligent mobility, image processing, and scientific software.">
  <PageHero eyebrow="Research & expertise" number="02" title="Methods built around the decision." intro="Optimization, prediction, routing, simulation, and image analysis—selected and combined according to the problem at hand." />
  <section class="bg-white py-20 lg:py-28"><div class="container"><SectionIntro eyebrow="Research areas" title="Four areas, connected by the same working principle." description="Start from the decision and its constraints, then build the model, method, and evidence needed to support it."/><div class="mt-12 grid sm:grid-cols-2">{researchAreas.map(area=><article id={area.slug} class="min-h-[360px] border border-line p-8 scroll-mt-24"><span class="font-mono text-xs text-teal">{area.number}</span><h2 class="mt-14 max-w-md font-display text-3xl leading-[1.08] tracking-[-.035em]">{area.title}</h2><p class="mt-5 text-sm font-semibold leading-7 text-ink">{area.short}</p><p class="mt-4 text-sm leading-7 text-slate">{area.body}</p></article>)}</div></div></section>
  <section id="software" class="bg-ink py-20 text-white scroll-mt-24 lg:py-28"><div class="container"><SectionIntro eyebrow="Technical practice" title="The tools behind the research." description="Reliable software turns a method into something that can be tested, challenged, reused, and improved by a wider team." light/><div class="mt-12 grid border-t border-white/15 lg:grid-cols-3">{capabilities.map((group,index)=><article class="border-b border-white/15 py-8 lg:border-b-0 lg:border-r lg:px-8 lg:first:pl-0"><span class="font-mono text-xs text-teal-light">0{index+1}</span><h3 class="mt-8 font-display text-3xl tracking-[-.03em]">{group.title}</h3><ul class="mt-6 grid gap-2 text-sm leading-7 text-white/65">{group.items.map(item=><li>— {item}</li>)}</ul></article>)}</div><p class="mt-10 max-w-3xl text-sm leading-7 text-white/55">The stack changes with each project. The standard does not: clear assumptions, reproducible experiments, and results that can be discussed with both technical and domain experts.</p></div></section>
</BaseLayout>
