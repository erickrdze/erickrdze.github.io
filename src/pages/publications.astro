---
import { getCollection } from 'astro:content';
import { ArrowUpRight } from 'lucide-astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';
const publications = (await getCollection('publications')).filter(p => p.data.verified).sort((a,b)=>b.data.year-a.data.year || Number(b.data.featured)-Number(a.data.featured));
const years = [...new Set(publications.map(p=>p.data.year))];
const types = [...new Set(publications.map(p=>p.data.type))];
---
<BaseLayout title="Publications" description="Journal articles and conference papers by Erick Rodríguez-Esparza in AI, optimization, mobility, and image processing.">
  <PageHero eyebrow="Publications" number="04" title="Research that moves between methods and applications." intro="Peer-reviewed work in optimization, evolutionary computation, mobility, machine learning, and biomedical image analysis." />
  <section class="bg-white py-16 lg:py-24"><div class="container">
    <div class="mb-10 flex flex-col gap-5 border-b border-line pb-8 md:flex-row md:items-end md:justify-between"><div><p class="text-sm text-slate"><strong class="text-ink">{publications.length} selected records</strong> from the verified CV bibliography.</p><p id="filter-status" class="mt-1 text-xs text-slate" aria-live="polite">Showing all publications</p></div><a href={site.profiles.scholar} target="_blank" rel="noreferrer" class="link-arrow text-teal">Google Scholar <ArrowUpRight size={15}/></a></div>
    <div class="mb-10 flex flex-wrap gap-2" aria-label="Publication filters"><button class="pub-filter rounded-full bg-ink px-4 py-2 text-xs font-bold text-white" data-filter="all" aria-pressed="true">All</button>{years.map(y=><button class="pub-filter rounded-full border border-line px-4 py-2 text-xs font-bold hover:border-teal" data-filter={String(y)} aria-pressed="false">{y}</button>)}{types.map(t=><button class="pub-filter rounded-full border border-line px-4 py-2 text-xs font-bold hover:border-teal" data-filter={t} aria-pressed="false">{t}</button>)}</div>
    <div id="publication-list">{publications.map((pub,index)=><article id={pub.id.replace('.md','')} data-publication data-year={pub.data.year} data-type={pub.data.type} class="grid gap-5 border-t border-line py-7 scroll-mt-24 lg:grid-cols-[55px_1fr_100px_35px]"><span class="font-mono text-xs text-teal">{String(index+1).padStart(2,'0')}</span><div><p class="text-[.65rem] font-extrabold uppercase tracking-[.12em] text-teal">{pub.data.type}{pub.data.area && ` · ${pub.data.area}`}</p><h2 class="mt-2 font-display text-2xl leading-tight tracking-[-.025em]">{pub.data.title}</h2><p class="mt-3 text-xs leading-6 text-slate">{pub.data.authors.join(', ')}</p><p class="mt-1 text-sm italic text-slate">{pub.data.venue}</p>{pub.data.project && <p class="mt-3 inline-flex rounded-full bg-teal-light/50 px-3 py-1 text-[.62rem] font-bold uppercase tracking-[.08em] text-teal">{pub.data.project}</p>}</div><div class="text-sm font-bold">{pub.data.year}</div>{pub.data.doi && <a href={pub.data.doi} target="_blank" rel="noreferrer" aria-label={`Open DOI for ${pub.data.title}`} class="hover:text-teal"><ArrowUpRight size={18}/></a>}</article>)}</div>
  </div></section>
  <script>
    const buttons=document.querySelectorAll<HTMLButtonElement>('.pub-filter');
    const records=document.querySelectorAll<HTMLElement>('[data-publication]');
    const status=document.querySelector('#filter-status');
    buttons.forEach(button=>button.addEventListener('click',()=>{const filter=button.dataset.filter;let visible=0;records.forEach(item=>{item.hidden=filter!=='all'&&item.dataset.year!==filter&&item.dataset.type!==filter;if(!item.hidden)visible++;});buttons.forEach(b=>{b.classList.remove('bg-ink','text-white');b.setAttribute('aria-pressed','false')});button.classList.add('bg-ink','text-white');button.setAttribute('aria-pressed','true');if(status)status.textContent=`Showing ${visible} publication${visible===1?'':'s'}`;}));
  </script>
</BaseLayout>
