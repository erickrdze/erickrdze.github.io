---
import { Image } from 'astro:assets'; import portrait from '../assets/erick-portrait.png';
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/PageHero.astro'; import SectionIntro from '../components/SectionIntro.astro';
import { activities, highlights, site, timeline } from '../data/site';
---
<BaseLayout title="About" description="Biography, education, international experience, and research profile of Dr. Erick Rodríguez-Esparza.">
  <PageHero eyebrow="About" number="01" title="A research path across engineering and computer science." intro="My training in biomedical engineering, computer science, and transport research shapes the way I approach AI and optimization." />
  <section class="bg-white py-20 lg:py-28"><div class="container grid gap-12 lg:grid-cols-[.38fr_1fr] lg:gap-16">
    <div><Image src={portrait} alt="Portrait of Erick Rodríguez-Esparza" widths={[420,640]} sizes="(min-width:1024px) 34vw, 100vw" format="webp" quality={84} loading="lazy" class="aspect-[4/5] w-full object-cover object-[62%_72%]"/><p class="mt-4 font-mono text-[.68rem] uppercase tracking-[.1em] text-slate">Bilbao, Spain · DeustoTech</p></div>
    <div><p class="eyebrow mb-7">Biography</p><div class="space-y-6 text-base leading-8 text-slate"><p class="font-display text-3xl leading-[1.25] tracking-[-.025em] text-ink">I am a postdoctoral researcher in Artificial Intelligence and Optimization at DeustoTech, University of Deusto.</p><p>I develop computational methods for planning and decision-making. Recent work includes dynamic fleet routing, roadworks scheduling, transport safety, industrial AI, and biomedical image analysis.</p><p>My role in collaborative R&D projects usually covers problem formulation, algorithm design, software implementation, and experimental evaluation. I work closely with researchers and domain specialists to make sure the method reflects the practical setting.</p><p>I completed my PhD in Engineering at the University of Deusto in 2024, graduating Outstanding Cum Laude with International Mention. My thesis focused on optimization methods and models for more sustainable and efficient last-mile logistics.</p><p>Before moving into transport research, I studied computer science and biomedical engineering in Mexico. This background taught me to work across disciplines while staying attentive to data quality, technical constraints, and the intended use of each result.</p></div><div class="mt-8 flex flex-wrap gap-3"><a href={`mailto:${site.email}`} class="rounded-full bg-ink px-5 py-2.5 text-xs font-bold uppercase tracking-[.08em] text-white no-underline hover:bg-teal">Contact Erick</a><a href={site.profiles.orcid} target="_blank" rel="noreferrer" class="rounded-full border border-line px-5 py-2.5 text-xs font-bold uppercase tracking-[.08em] no-underline hover:border-teal">ORCID</a></div></div>
  </div></section>
  <section class="border-y border-line bg-paper"><div class="container grid grid-cols-2 md:grid-cols-4">{highlights.map(item=><div class="border-b border-line px-4 py-6 first:pl-0 md:border-b-0 md:border-l md:px-7"><strong class="font-display text-4xl font-medium">{item.value}</strong><p class="mt-1 text-[.64rem] font-bold uppercase tracking-[.1em] text-slate">{item.label}</p></div>)}</div><p class="container py-3 text-right text-[.62rem] text-slate">Bibliometric metrics as of 22 September 2026.</p></section>
  <section class="py-20 lg:py-28"><div class="container"><SectionIntro eyebrow="Trajectory" title="Education and international experience."/><div class="mt-12">{timeline.map((item,index)=><article class="grid gap-4 border-t border-line py-7 lg:grid-cols-[70px_.25fr_.45fr_1fr]"><span class="font-mono text-xs text-teal">0{index+1}</span><p class="text-xs font-extrabold uppercase tracking-[.1em] text-slate">{item.period}</p><div><h3 class="font-display text-2xl tracking-[-.02em]">{item.title}</h3><p class="mt-1 text-xs font-bold text-teal">{item.place}</p></div><p class="text-sm leading-7 text-slate">{item.detail}</p></article>)}</div></div></section>
  <section class="bg-[#e6efec] py-20"><div class="container"><SectionIntro eyebrow="Recognition" title="Awards and competitive support."/><div class="mt-10 grid md:grid-cols-3">{activities.filter(a=>a.type==='Award'||a.type==='Fellowship').map(item=><article class="border border-line bg-white p-7"><p class="font-mono text-xs text-teal">{item.year}</p><h3 class="mt-8 font-display text-2xl leading-tight">{item.title}</h3><p class="mt-3 text-sm leading-7 text-slate">{item.detail}</p></article>)}</div></div></section>
</BaseLayout>
