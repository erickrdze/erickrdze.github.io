---
import { ArrowUpRight } from 'lucide-astro';
import { navigation, site } from '../data/site';
---
<footer class="bg-ink text-white">
  <div class="container py-16 lg:py-20">
    <div class="grid gap-12 border-b border-white/15 pb-14 lg:grid-cols-[1.25fr_.75fr]">
      <div>
        <p class="mb-5 text-xs font-extrabold uppercase tracking-[.16em] text-teal-light">Research · Systems · Collaboration</p>
        <p class="max-w-2xl font-display text-4xl leading-[1.05] tracking-[-.035em] sm:text-5xl">Research collaboration in AI and optimization.</p>
      </div>
      <div class="lg:justify-self-end">
        <p class="mb-4 max-w-sm text-sm leading-7 text-white/65">I work with research groups, R&D consortia, and technical teams on optimization, mobility, logistics, and applied AI.</p>
        <a class="link-arrow text-teal-light" href="/contact/">Start a conversation <ArrowUpRight size={15}/></a>
      </div>
    </div>
    <div class="flex flex-col gap-8 pt-8 text-xs text-white/55 lg:flex-row lg:items-end lg:justify-between">
      <div><p class="mb-1 font-bold text-white">{site.name}</p><p>{site.affiliation} · {site.location}</p></div>
      <nav class="flex flex-wrap gap-x-5 gap-y-2" aria-label="Footer navigation">{navigation.map(item => <a class="no-underline hover:text-white" href={item.href}>{item.label}</a>)}</nav>
      <p>© {new Date().getFullYear()} {site.name}</p>
    </div>
  </div>
</footer>
